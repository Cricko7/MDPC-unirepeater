{
  "openapi": "3.1.0",
  "info": {
    "title": "Датарк API",
    "version": "1.1.0",
    "description": "Запросы к серверу демонстрации. PUT заменяет общие стартовые настройки. Перед изменением скопируйте текущий JSON из GET."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/telemetry": {
      "get": {
        "operationId": "getTelemetry",
        "summary": "Тестовая телеметрия репитера и пяти зон",
        "description": "Сервер формирует синтетические отсчёты каждые пять секунд. Если сценарий не указан, применяется настройка сайта.",
        "parameters": [
          {
            "name": "scenario",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "mixed",
                "normal",
                "offline"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Текущие значения, восемь отсчётов и активные тревоги",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Telemetry"
                }
              }
            }
          },
          "400": {
            "description": "Недопустимый сценарий"
          },
          "503": {
            "description": "Настройки сервера недоступны"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Состояние и ревизия сервера",
        "responses": {
          "200": {
            "description": "Сервис работает",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok",
                  "revision": "61f46dbc19a9a565d27d0e3c008696ae277dea9a"
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Настройки недоступны или некорректны",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "unhealthy",
                  "revision": "61f46dbc19a9a565d27d0e3c008696ae277dea9a"
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          }
        },
        "operationId": "getHealth",
        "tags": [
          "Диагностика"
        ],
        "description": "Возвращает состояние и ревизию развёрнутого образа. При недоступной или некорректной конфигурации возвращает 503."
      }
    },
    "/assets/site-defaults.json": {
      "get": {
        "summary": "Публичные стартовые настройки",
        "responses": {
          "200": {
            "description": "Текущие настройки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Настройки недоступны",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          }
        },
        "operationId": "getSiteDefaults",
        "tags": [
          "Настройки сайта"
        ],
        "description": "Читает общие стартовые параметры мониторинга, LTE и тестового GSM."
      }
    },
    "/admin/settings": {
      "get": {
        "summary": "Прочитать настройки администратора",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Текущие настройки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Запрос логина и пароля HTTP Basic.",
                "schema": {
                  "type": "string"
                },
                "example": "Basic realm=\"Datark admin\", charset=\"UTF-8\""
              }
            }
          },
          "503": {
            "description": "Настройки или пароль недоступны",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "getAdminSettings",
        "tags": [
          "Администрирование"
        ],
        "description": "Требует HTTP Basic и возвращает текущие общие настройки."
      },
      "put": {
        "summary": "Заменить стартовые настройки",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-Datark-Admin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "settings"
              ],
              "default": "settings"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              },
              "example": {
                "scenario": "mixed",
                "calculator": {
                  "operators": [
                    {
                      "name": "МТС",
                      "band": "B1",
                      "bandwidth_mhz": 10,
                      "das_dl_dbm": 16
                    },
                    {
                      "name": "МегаФон",
                      "band": "B1",
                      "bandwidth_mhz": 10,
                      "das_dl_dbm": 16
                    },
                    {
                      "name": "билайн",
                      "band": "B1",
                      "bandwidth_mhz": 10,
                      "das_dl_dbm": 16
                    },
                    {
                      "name": "t2",
                      "band": "B1",
                      "bandwidth_mhz": 10,
                      "das_dl_dbm": 16
                    },
                    {
                      "name": "МОТИВ",
                      "band": "B3",
                      "bandwidth_mhz": 10,
                      "das_dl_dbm": 16
                    }
                  ],
                  "gsm": {
                    "band": "1800",
                    "arfcn": 698
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Настройки сохранены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные настройки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Запрос логина и пароля HTTP Basic.",
                "schema": {
                  "type": "string"
                },
                "example": "Basic realm=\"Datark admin\", charset=\"UTF-8\""
              }
            }
          },
          "403": {
            "description": "Неверный заголовок или тип запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Недопустимый размер запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Ошибка записи",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Пароль администратора недоступен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "replaceAdminSettings",
        "tags": [
          "Администрирование"
        ],
        "description": "Требует HTTP Basic, JSON и заголовок X-Datark-Admin: settings. Заменяет общие стартовые настройки целиком. Максимальный размер тела 16 384 байта."
      }
    },
    "/api/sms-test-results": {
      "get": {
        "summary": "Результаты испытаний аварийных SMS",
        "description": "Возвращает две синтетические серии при выключенном и включённом LTE. Задержка считается от отправки до подтверждённого приёма. В интерфейсе процент доставки равен delivered / sent × 100, а изменение средней задержки равно mean при включённом LTE минус mean при выключенном LTE. Если отправок или подтверждённых доставок недостаточно, соответствующая метрика отсутствует в сравнении.",
        "responses": {
          "200": {
            "description": "Сводка по обоим режимам LTE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsTestResults"
                },
                "example": {
                  "source": "synthetic",
                  "results": [
                    {
                      "lte_mode": "off",
                      "sent": 10,
                      "delivered": 10,
                      "latency_ms": {
                        "min": 1110,
                        "mean": 1254,
                        "max": 1410
                      }
                    },
                    {
                      "lte_mode": "on",
                      "sent": 10,
                      "delivered": 9,
                      "latency_ms": {
                        "min": 1380,
                        "mean": 1580,
                        "max": 1820
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          }
        },
        "operationId": "getSmsTestResults",
        "tags": [
          "Испытания SMS"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
    "Telemetry": {
      "type": "object",
      "required": [
        "source",
        "time",
        "scenario",
        "online",
        "donor",
        "zones",
        "samples",
        "alarms"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "synthetic"
          ]
        },
        "time": {
          "type": "integer",
          "format": "int64",
          "description": "Время последнего отсчёта в миллисекундах Unix."
        },
        "scenario": {
          "type": "string",
          "enum": [
            "mixed",
            "normal",
            "offline"
          ]
        },
        "online": {
          "type": "boolean",
          "description": "Состояние репитера R1."
        },
        "donor": {
          "$ref": "#/components/schemas/RadioReading"
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "reading"
            ],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "A1",
                  "A2",
                  "A3",
                  "A4",
                  "A5"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "good",
                  "warning",
                  "critical"
                ]
              },
              "reading": {
                "$ref": "#/components/schemas/ZoneReading"
              }
            }
          },
          "minItems": 5,
          "maxItems": 5
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "time",
              "zones"
            ],
            "properties": {
              "time": {
                "type": "integer",
                "format": "int64"
              },
              "zones": {
                "type": "object",
                "required": [
                  "A1",
                  "A2",
                  "A3",
                  "A4",
                  "A5"
                ],
                "properties": {
                  "A1": {
                    "$ref": "#/components/schemas/ZoneReading"
                  },
                  "A2": {
                    "$ref": "#/components/schemas/ZoneReading"
                  },
                  "A3": {
                    "$ref": "#/components/schemas/ZoneReading"
                  },
                  "A4": {
                    "$ref": "#/components/schemas/ZoneReading"
                  },
                  "A5": {
                    "$ref": "#/components/schemas/ZoneReading"
                  }
                }
              }
            }
          },
          "minItems": 8,
          "maxItems": 8
        },
        "alarms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sourceId",
              "type"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "enum": [
                  "R1",
                  "A1",
                  "A2",
                  "A3",
                  "A4",
                  "A5"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "rf-off",
                  "low-signal",
                  "no-telemetry"
                ]
              }
            }
          }
        }
      }
    },
    "RadioReading": {
      "type": "object",
      "required": [
        "rsrp",
        "sinr"
      ],
      "properties": {
        "rsrp": {
          "type": "number",
          "description": "RSRP в дБм."
        },
        "sinr": {
          "type": "number",
          "description": "SINR в дБ."
        }
      }
    },
    "ZoneReading": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/RadioReading"
        },
        {
          "type": "null"
        }
      ]
    },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "revision"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unhealthy"
            ]
          },
          "revision": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Operator": {
        "type": "object",
        "required": [
          "name",
          "band",
          "bandwidth_mhz",
          "das_dl_dbm"
        ],
        "properties": {
          "name": {
            "enum": [
              "МТС",
              "МегаФон",
              "билайн",
              "t2",
              "МОТИВ"
            ]
          },
          "band": {
            "enum": [
              "B1",
              "B3",
              "B7"
            ]
          },
          "bandwidth_mhz": {
            "enum": [
              1.4,
              3,
              5,
              10,
              15,
              20
            ]
          },
          "das_dl_dbm": {
            "type": "number"
          },
          "dl_mhz": {
            "type": [
              "number",
              "null"
            ],
            "description": "Центр DL в МГц. При отсутствии используется верхняя граница диапазона."
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "scenario",
          "calculator"
        ],
        "properties": {
          "scenario": {
            "enum": [
              "mixed",
              "normal",
              "offline"
            ]
          },
          "calculator": {
            "type": "object",
            "required": [
              "operators",
              "gsm"
            ],
            "properties": {
              "operators": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "description": "Порядок: МТС, МегаФон, билайн, t2, МОТИВ. Ширина и частота должны соответствовать выбранному диапазону.",
                "items": {
                  "$ref": "#/components/schemas/Operator"
                }
              },
              "gsm": {
                "type": "object",
                "required": [
                  "band",
                  "arfcn"
                ],
                "properties": {
                  "band": {
                    "enum": [
                      "900",
                      "1800"
                    ]
                  },
                  "arfcn": {
                    "type": "integer",
                    "description": "Для 900: 0–124 или 975–1023. Для 1800: 512–885."
                  }
                }
              }
            }
          }
        }
      },
      "SmsTestResults": {
        "type": "object",
        "required": [
          "source",
          "results"
        ],
        "properties": {
          "source": {
            "const": "synthetic"
          },
          "results": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "lte_mode",
                "sent",
                "delivered",
                "latency_ms"
              ],
              "properties": {
                "lte_mode": {
                  "enum": [
                    "off",
                    "on"
                  ]
                },
                "sent": {
                  "type": "integer",
                  "minimum": 0
                },
                "delivered": {
                  "type": "integer",
                  "minimum": 0
                },
                "latency_ms": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "Задержка подтверждённых доставок в миллисекундах. Null при отсутствии доставок.",
                  "required": [
                    "min",
                    "mean",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "number",
                      "minimum": 0
                    },
                    "mean": {
                      "type": "number",
                      "minimum": 0
                    },
                    "max": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
