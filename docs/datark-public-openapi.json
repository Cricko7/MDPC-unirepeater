{
  "openapi": "3.0.3",
  "info": {
    "title": "Датарк — публичный API",
    "version": "1.1.0",
    "description": "Публичные GET-запросы демонстрационного сервера. Результаты испытаний SMS синтетические."
  },
  "servers": [
    {
      "url": "https://72.56.14.198"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Состояние и ревизия сервера",
        "responses": {
          "200": {
            "description": "Сервис работает",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok",
                  "revision": "61f46dbc19a9a565d27d0e3c008696ae277dea9a"
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Настройки недоступны или некорректны",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "unhealthy",
                  "revision": "61f46dbc19a9a565d27d0e3c008696ae277dea9a"
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          }
        },
        "operationId": "getHealth",
        "tags": [
          "Диагностика"
        ],
        "description": "Возвращает состояние и ревизию развёрнутого образа. При недоступной или некорректной конфигурации возвращает 503."
      }
    },
    "/assets/site-defaults.json": {
      "get": {
        "summary": "Публичные стартовые настройки",
        "responses": {
          "200": {
            "description": "Текущие настройки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Настройки недоступны",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          }
        },
        "operationId": "getSiteDefaults",
        "tags": [
          "Настройки сайта"
        ],
        "description": "Читает общие стартовые параметры мониторинга, LTE и тестового GSM."
      }
    },
    "/api/sms-test-results": {
      "get": {
        "summary": "Результаты испытаний аварийных SMS",
        "description": "Возвращает две синтетические серии при выключенном и включённом LTE. Задержка считается от отправки до подтверждённого приёма. В интерфейсе процент доставки равен delivered / sent × 100, а изменение средней задержки равно mean при включённом LTE минус mean при выключенном LTE. Если отправок или подтверждённых доставок недостаточно, соответствующая метрика отсутствует в сравнении.",
        "responses": {
          "200": {
            "description": "Сводка по обоим режимам LTE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsTestResults"
                },
                "example": {
                  "source": "synthetic",
                  "results": [
                    {
                      "lte_mode": "off",
                      "sent": 10,
                      "delivered": 10,
                      "latency_ms": {
                        "min": 1110,
                        "mean": 1254,
                        "max": 1410
                      }
                    },
                    {
                      "lte_mode": "on",
                      "sent": 10,
                      "delivered": 9,
                      "latency_ms": {
                        "min": 1380,
                        "mean": 1580,
                        "max": 1820
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "Access-Control-Allow-Origin": {
                "description": "Присутствует при запросе с разрешённого адреса Swagger Editor.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "https://editor.swagger.io",
                    "https://jdegre.github.io"
                  ]
                }
              }
            }
          }
        },
        "operationId": "getSmsTestResults",
        "tags": [
          "Испытания SMS"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "revision"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unhealthy"
            ]
          },
          "revision": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Operator": {
        "type": "object",
        "required": [
          "name",
          "band",
          "bandwidth_mhz",
          "das_dl_dbm"
        ],
        "properties": {
          "name": {
            "enum": [
              "МТС",
              "МегаФон",
              "билайн",
              "t2",
              "МОТИВ"
            ]
          },
          "band": {
            "enum": [
              "B1",
              "B3",
              "B7"
            ]
          },
          "bandwidth_mhz": {
            "enum": [
              1.4,
              3,
              5,
              10,
              15,
              20
            ]
          },
          "das_dl_dbm": {
            "type": "number"
          },
          "dl_mhz": {
            "type": "number",
            "description": "Центр DL в МГц. При отсутствии используется верхняя граница диапазона.",
            "nullable": true
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "scenario",
          "calculator"
        ],
        "properties": {
          "scenario": {
            "enum": [
              "mixed",
              "normal",
              "offline"
            ]
          },
          "calculator": {
            "type": "object",
            "required": [
              "operators",
              "gsm"
            ],
            "properties": {
              "operators": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "description": "Порядок: МТС, МегаФон, билайн, t2, МОТИВ. Ширина и частота должны соответствовать выбранному диапазону.",
                "items": {
                  "$ref": "#/components/schemas/Operator"
                }
              },
              "gsm": {
                "type": "object",
                "required": [
                  "band",
                  "arfcn"
                ],
                "properties": {
                  "band": {
                    "enum": [
                      "900",
                      "1800"
                    ]
                  },
                  "arfcn": {
                    "type": "integer",
                    "description": "Для 900: 0–124 или 975–1023. Для 1800: 512–885."
                  }
                }
              }
            }
          }
        }
      },
      "SmsTestResults": {
        "type": "object",
        "required": [
          "source",
          "results"
        ],
        "properties": {
          "source": {
            "enum": [
              "synthetic"
            ]
          },
          "results": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "lte_mode",
                "sent",
                "delivered",
                "latency_ms"
              ],
              "properties": {
                "lte_mode": {
                  "enum": [
                    "off",
                    "on"
                  ]
                },
                "sent": {
                  "type": "integer",
                  "minimum": 0
                },
                "delivered": {
                  "type": "integer",
                  "minimum": 0
                },
                "latency_ms": {
                  "type": "object",
                  "description": "Задержка подтверждённых доставок в миллисекундах. Null при отсутствии доставок.",
                  "required": [
                    "min",
                    "mean",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "number",
                      "minimum": 0
                    },
                    "mean": {
                      "type": "number",
                      "minimum": 0
                    },
                    "max": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "nullable": true
                }
              }
            }
          }
        }
      }
    }
  }
}
